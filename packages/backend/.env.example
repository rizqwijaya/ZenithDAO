# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zenithdao

# Sepolia RPC URL (same as contracts)
SEPOLIA_RPC_URL=

# Deployed contract addresses (fill after deploy, or run extract-addresses.mjs)
ZENITH_TOKEN_ADDRESS=
ZENITH_GOVERNOR_ADDRESS=
ZENITH_VAULT_ADDRESS=
TIMELOCK_ADDRESS=

# Block to start indexing from (set to the deploy block; defaults to chain head)
START_BLOCK=

# HTTP port
PORT=3001

# Indexer tuning (optional)
POLL_INTERVAL_MS=12000
# Max blocks per eth_getLogs call. Alchemy/Infura FREE tier = 10. Paid/most RPCs allow 2000+.
LOG_CHUNK_SIZE=10
