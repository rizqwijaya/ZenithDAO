{
  "name": "@zenithdao/contracts",
  "version": "1.0.0",
  "private": true,
  "description": "ZenithDAO smart contracts - Solidity + Foundry + OpenZeppelin",
  "license": "MIT",
  "scripts": {
    "build": "forge build",
    "test": "forge test -vvv",
    "fmt": "forge fmt",
    "deploy:sepolia": "forge script script/Deploy.s.sol:Deploy --rpc-url sepolia --broadcast --verify -vvvv",
    "deploy:sepolia:dry": "forge script script/Deploy.s.sol:Deploy --rpc-url sepolia -vvvv",
    "airdrop:gen": "node script/merkle-airdrop.mjs",
    "deploy:airdrop:sepolia": "forge script script/DeployAirdrop.s.sol:DeployAirdrop --rpc-url sepolia --broadcast --verify -vvvv",
    "deploy:airdrop:sepolia:dry": "forge script script/DeployAirdrop.s.sol:DeployAirdrop --rpc-url sepolia -vvvv"
  },
  "devDependencies": {
    "@openzeppelin/merkle-tree": "^1.0.8"
  }
}
