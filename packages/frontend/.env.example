# Alchemy app id for the Sepolia RPC transport
VITE_ALCHEMY_ID=

# WalletConnect / Reown project id (https://cloud.reown.com) - required by RainbowKit
VITE_WALLETCONNECT_ID=

# Backend indexer base URL
VITE_API_URL=http://localhost:3001

# Deployed contract addresses (fill after deploy, or run extract-addresses.mjs)
VITE_GOVERNOR_ADDRESS=
VITE_TOKEN_ADDRESS=
VITE_VAULT_ADDRESS=
VITE_TIMELOCK_ADDRESS=
